{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini Notes",
  "version": "0.3.1",
  "identifier": "app.mini.notes.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mini Notes",
        "width": 620,
        "height": 680,
        "minWidth": 370,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "center": true,
        "backgroundColor": "#FFFEFA",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
